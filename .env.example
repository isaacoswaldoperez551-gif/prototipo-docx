# ==============================================================================
# DOCUGUARD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copia este archivo a .env y define valores seguros y aleatorios para producción.
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Base de datos PostgreSQL 16
DATABASE_URL=postgresql://docu_user:docu_secure_password_2026@db:5432/docuguard_db?schema=public
POSTGRES_USER=docu_user
POSTGRES_PASSWORD=docu_secure_password_2026
POSTGRES_DB=docuguard_db
DB_HOST=db
DB_PORT=5432

# Criptografía y JWT (Mínimo 32 caracteres criptográficamente seguros)
JWT_ACCESS_SECRET=c8f53a9e10d29487b3e10fa7c91d84b23e7102f489a65b7194c038d1048b61c9
JWT_REFRESH_SECRET=7f2a1b9c0d4e8a3b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Seguridad de Cookies (HttpOnly, Secure, SameSite=Strict)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Control de Intentos de Acceso (Rate Limiting y Brute Force)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Almacenamiento Seguro S3 / MinIO
STORAGE_DRIVER=s3
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_secret_2026
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=docuguard-documents
LOCAL_STORAGE_DIR=/app/storage/documents

# Límites de Subida de Archivos
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown
